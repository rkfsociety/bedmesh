webpanel/gkbridge binary
webpanel/index.html text eol=lf
webpanel/gkbridge.version text eol=lf
# Файлы камеры: бинарники/.so — бинарные, shell-скрипты — LF.
webpanel/camera/mjpg_streamer binary

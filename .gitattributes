# Скрипты, исполняемые на принтере (busybox/ash) — всегда LF, иначе ломается шебанг.
win/pyqt6/resources/boot.sh text eol=lf
# Веб-панель: бинарник (armv7) — бинарный без конвертаций; index.html встраивается

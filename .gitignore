# Виртуальные окружения (САМОЕ ВАЖНОЕ)
.venv/
venv/

# Кэши Python
__pycache__/
*.py[cod]

# Логи и временные файлы
debug.log
temp_download.cfg
*.log
*.tmp
download_*.cfg

# Локальные настройки (пароли, пути)
settings*.json

# Сборка PyInstaller
dist/
build/
*.exe
*.spec
win/pyqt6/debug.log
win/pyqt6/temp_download.cfg

# Android / Gradle (локальные кэши и артефакты сборки)
android/.gradle/
android/**/build/
android/local.properties

# Подпись Android — только локально, переносите на другой ПК вручную (флешка и т.п.)
android/keystore/*.jks
android/keystore.properties
